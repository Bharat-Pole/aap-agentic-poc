# =============================================================================
# Agentic Inventory-Replenishment POC — environment template.
# Copy to `.env` and fill in as needed:  cp .env.example .env
# NOTHING here is required for Phase 0 (data layer). LLM keys are only used
# later, for (a) draft-PO justification text and (b) notification phrasing.
# No keys are ever hardcoded in source — they are read from the environment.
# =============================================================================

# Master switch for the two LLM edges (draft justification + notification body).
# Set USE_LLM=false to run the whole POC fully deterministic (template-only) for
# an offline demo. Default: true.
USE_LLM=true

# Provider preference order is resolved by the LLM wrapper at runtime:
#   gemini  -> ollama  -> deterministic template (last-resort, never fails)
# Set this to force a specific primary provider. Default: gemini.
LLM_PROVIDER=gemini

# --- Google Gemini (primary; free tier) -------------------------------------
# Get a key at https://aistudio.google.com/app/apikey  (leave blank to skip).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Ollama (local fallback) -------------------------------------------------
# Run `ollama serve` and `ollama pull qwen2.5` to enable.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5

# --- Determinism -------------------------------------------------------------
# Fixed seed + reference "today" so all four scenarios reproduce exactly.
POC_RANDOM_SEED=42
POC_REFERENCE_DATE=2026-06-09
